[sub_resource type="Resource" id="Resource_ybdra"]
script = ExtResource("1_uihat")
texto = "Calma novato, eu sei como te ajudar."
metadata/_custom_type_script = "uid://btolrf4p1yhho"

[sub_resource type="Resource" id="Resource_675ky"]
script = ExtResource("1_uihat")
texto = "Na árvore de habilidades, adquira a evolução \"Início\"."
metadata/_custom_type_script = "uid://btolrf4p1yhho"

[sub_resource type="Resource" id="Resource_gm1hx"]
script = ExtResource("1_uihat")
texto = "Para se libertar dessa maldição, você precisa dominar todo o grimório."
metadata/_custom_type_script = "uid://btolrf4p1yhho"

[sub_resource type="Resource" id="Resource_y2ac8"]
script = ExtResource("1_uihat")
texto = "Para conseguir novos feitiços, você vai precisar ir para arenas derrotar monstros."
metadata/_custom_type_script = "uid://btolrf4p1yhho"

[sub_resource type="Resource" id="Resource_soqai"]
script = ExtResource("1_uihat")
texto = "Ah, quase me esqueci!"
metadata/_custom_type_script = "uid://btolrf4p1yhho"

[sub_resource type="Resource" id="Resource_otqrw"]
script = ExtResource("2_ybdra")
texto_opcao = "Ok, irei para a biblioteca!"
metadata/_custom_type_script = "uid://c18eulvmcbep4"

[sub_resource type="Resource" id="Resource_nk2u0"]
script = ExtResource("1_uihat")
texto = "Assim que você sair daqui, vá para a biblioteca. Lá, você encontra textos explicando como o grimório funciona."
tem_opcoes = true
opcoes = Array[ExtResource("2_ybdra")]([SubResource("Resource_otqrw")])
metadata/_custom_type_script = "uid://btolrf4p1yhho"

[sub_resource type="Resource" id="Resource_alepv"]
script = ExtResource("2_ybdra")
texto_opcao = "Muito obrigado, Mago Velho."
linhas = Array[ExtResource("1_uihat")]([SubResource("Resource_soqai"), SubResource("Resource_nk2u0")])
metadata/_custom_type_script = "uid://c18eulvmcbep4"

[sub_resource type="Resource" id="Resource_p3lig"]
script = ExtResource("1_uihat")
texto = "Traga os recursos que você conseguir de volta para cá, e podemos usá-los como ingredientes para novos feitiços!"
tem_opcoes = true
opcoes = Array[ExtResource("2_ybdra")]([SubResource("Resource_alepv")])
metadata/_custom_type_script = "uid://btolrf4p1yhho"

[sub_resource type="Resource" id="Resource_uihat"]
script = ExtResource("2_ybdra")
texto_opcao = "Eu encontrei o Omni-Grimório!"
linhas = Array[ExtResource("1_uihat")]([SubResource("Resource_ybdra"), SubResource("Resource_675ky"), SubResource("Resource_gm1hx"), SubResource("Resource_y2ac8"), SubResource("Resource_p3lig")])
metadata/_custom_type_script = "uid://c18eulvmcbep4"

[sub_resource type="Resource" id="Resource_7eupd"]
