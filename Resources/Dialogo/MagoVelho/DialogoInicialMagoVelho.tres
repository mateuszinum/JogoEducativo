[gd_resource type="Resource" script_class="DialogoResource" format=3 uid="uid://dtf31oqnbdoio"]

[ext_resource type="Script" uid="uid://btolrf4p1yhho" path="res://Scripts/Dialogo/linha_dialogo.gd" id="1_uihat"]
[ext_resource type="Script" uid="uid://c18eulvmcbep4" path="res://Scripts/Dialogo/opcao_dialogo.gd" id="2_ybdra"]
