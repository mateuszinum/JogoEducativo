texto = "Preciso sair de casa, vou usar minha magia de movimento. "
metadata/_custom_type_script = "uid://btolrf4p1yhho"

[sub_resource type="Resource" id="Resource_tq1hq"]
script = ExtResource("1_tq1hq")
texto = "Para andar, basta eu escrever em sequência vários \"mover(Cima)\", \"mover(Baixo)\", \"mover(Direita)\" ou \"mover(Esquerda)\". Fazendo isso, eu consigo andar para Cima, Baixo, Direita ou Esquerda (respectivamente)!"
