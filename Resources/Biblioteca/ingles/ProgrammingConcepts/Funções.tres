[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_1od18")
texto = "As funções são blocos de código personalizados que você cria para não ter que repetir as mesmas linhas várias vezes. É como ensinar um novo \"truque\" ao seu personagem.

Ao criar uma função, você deve dizer qual o tipo de dado que ela vai devolver no final (ou usar vazio se ela não devolver nada). Você também pode passar informações para ela trabalhar, chamadas de parâmetros.
"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

