[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_1fi3q")
texto = "The ghost switches between physical and ethereal states (depending on the game clock). It has low health, but is invulnerable while in ethereal form.

Hint: Check the timer. If the last digit is between 0 and 4, the ghosts will be ethereal. If the last digit is between 5 and 9, they will be physical.

Note: This is no Casper—this guy is way worse."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

