[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_bswgf")
texto = "This arena works differently from the others. There are no enemies; it is just a maze with a treasure.

In this arena, you must implement an algorithm to solve the maze.

Hint: Did you know that the greatest secret of mazes is to choose a wall and never take your hand off it? If you follow the path without ever letting go of the wall, you will end up exploring the entire maze!"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

