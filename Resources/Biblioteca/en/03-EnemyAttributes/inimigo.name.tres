[sub_resource type="Resource" id="Resource_0dx7l"]
script = ExtResource("1_q4f5b")
tipo = 3
texto = "#Example 1

se(inimigoMaisProximo().nome == SlimeDeFogo):
	atacar(inimigoMaisProximo().nome, Gelo)
senao:
	atacar(inimigoMaisProximo().nome, EsferaAzul)
fim se

#Example 2

Inimigo i = inimigoMaisProximo()

se(i.nome == SlimeDeFogo):
	atacar(i, Gelo)
senao:
	atacar(i, EsferaAzul)
fim se"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

