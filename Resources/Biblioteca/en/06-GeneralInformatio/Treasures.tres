[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_812ym")
texto = "Every battle arena hides riches! At any point during your match, there will always be exactly one active treasure on the map. It uses the same grid system as the character, meaning the treasure is located at an XY coordinate.

Upon reaching the treasure, you collect it, and another one immediately spawns at a random location in the arena.

Tip: To collect treasures, you need to write a pathfinding algorithm that moves the character to the treasure's coordinate by comparing it to the character's current 
position. Make sure your code can navigate around obstacles in the way!
"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

