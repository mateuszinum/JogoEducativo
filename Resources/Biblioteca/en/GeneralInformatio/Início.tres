[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_510j8")
texto = "Aqui vai uma sugestão para o seu primeiro programa!

Tente entrar na arena Campos usando o comando \"arena\". Depois, use o comando \"atacar\" com \"EsferaAzul\" no alvo que estiver por perto.

Muitos inimigos vão aparecer, então você precisará realizar muitos ataques. Coloque vários ataques em sequência, como por exemplo:"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_muvxh"]
script = ExtResource("1_510j8")
tipo = 3
texto = "arena(Campos)

atacar(inimigoMaisProximo(), EsferaAzul)
atacar(inimigoMaisProximo(), EsferaAzul)
atacar(inimigoMaisProximo(), EsferaAzul)
atacar(inimigoMaisProximo(), EsferaAzul)
[...]"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_1rkxv"]
script = ExtResource("1_510j8")
tipo = 2
texto = "Leia também"
