[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_itys6")
texto = "Comments are invisible notes for the game interpreter. Any text written after the # symbol on a line will be ignored by the system.

They are essential for you to organize your code and leave reminders for yourself about what each part does!"
