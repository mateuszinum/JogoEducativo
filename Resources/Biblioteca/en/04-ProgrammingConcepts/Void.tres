[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_aic4m")
texto = "Void is a special data type that represents absolute emptiness. When a variable has nothing inside, or when you try to look for a target and find no one, the system returns Void.

It is very useful for checking if something exists before trying to interact with it."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

