[sub_resource type="Resource" id="Resource_btp45"]
script = ExtResource("1_dg82a")
tipo = 3
texto = "int somarValores(int a, int b):
	int resultado = a + b
	retorna resultado
fim funcao

int numero1 = 50
int numero2 = 30

int soma = somarValores(numero1, numero2)
# A variável soma agora vale 80!"
