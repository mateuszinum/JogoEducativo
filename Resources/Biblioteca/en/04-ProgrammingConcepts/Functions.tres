[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_dg82a")
texto = "Functions are custom blocks of code you create so you don't have to repeat the same lines multiple times. It's like teaching a new \"trick\" to your character.

When creating a function, you must state what data type it will return at the end (or use void if it doesn't return anything). You can also pass information for it to work with, called parameters."
