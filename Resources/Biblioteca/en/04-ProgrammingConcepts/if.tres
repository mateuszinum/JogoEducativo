[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_8x32w")
texto = "The if structure allows your code to make decisions. It's like saying: \"If this is true, do that. Otherwise, do something else.\"

You write the condition inside parentheses and use a colon : to open the block of actions. Don't forget to close with end if!"
