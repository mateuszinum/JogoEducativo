[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_w4y7e")
texto = "The \"while\" serves to repeat a block of code multiple times, as long as the condition you chose remains true. It is perfect for executing continuous actions.

The structure must be closed with an \"end while\"

Tip: If you want an infinite loop, use \"while(True)\"."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

