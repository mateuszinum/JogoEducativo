[sub_resource type="Resource" id="Resource_sj6m0"]
script = ExtResource("1_16yci")
tipo = 1
texto = "Lists"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_16yci")
texto = "Lists allow you to store multiple values within a single variable. To create a list, you place the values between square brackets [], separated by commas.

To access or change a specific item within the list, we use its index.

Remember: in programming, counting always starts at zero! Therefore, the first item is [0], the second is [1], and so on."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_u3s6p"]
script = ExtResource("1_16yci")
tipo = 2
texto = "Usage example"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_cywvo"]
script = ExtResource("1_16yci")
tipo = 3
texto = "int numeros = [10, 20, 30]
int primeiroNumero = numeros[0]
# A variável primeiroNumero agora vale 10"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

