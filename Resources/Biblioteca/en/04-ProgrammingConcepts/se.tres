[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_iljup")
texto = "A estrutura se permite que o seu código tome decisões. É como dizer: \"Se isso for verdade, faça aquilo. Senão, faça outra coisa.\"

Você escreve a condição entre parênteses e usa os dois pontos : para abrir o bloco de ações. Não se esqueça de fechar com o fim se!"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

