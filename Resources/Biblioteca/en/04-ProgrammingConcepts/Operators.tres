[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_8dojr")
texto = "Operators are the symbols we use to do math, compare things, or combine comparisons.

Arithmetic (Basic math):
	+ : Addition
	- : Subtraction
	* : Multiplication
	/ : Division
	% : Remainder of division

Comparison (To ask questions):
	== : Is equal to?
	!= : Is different from?
	>= : Greater than or equal to
	<= : Less than or equal to

Logical (To combine comparisons):
	and : Both conditions must be true.
	or : Only one of the conditions needs to be true.
	! : Inverts the rule (what was True becomes False)."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

