int level = 5
if(level >= 10):
    write(\"You are very strong!\")
end if

if(target == Null):
    write(\"No enemy found.\")
end if

int counter = 50
bool value = True
if(counter >= 20 and value):
    attack(nearestEnemy(), BlueSphere)
end if

bool hasEnoughHealth = False
if(!hasEnoughHealth):
    write(\"Careful, you are unprotected!\")
end if"
