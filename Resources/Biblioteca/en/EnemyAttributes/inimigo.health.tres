[sub_resource type="Resource" id="Resource_0dx7l"]
script = ExtResource("1_rtxgq")
tipo = 3
texto = "#Exemplo 1
se(inimigoMaisProximo().vida == 1):
	atacar(inimigoMaisProximo(), Raio)
senao:
	atacar(inimigoMaisProximo(), EsferaAzul)
fim se

#Exemplo 2
Inimigo i = inimigoMaisProximo()

se(i.vida == 1):
	atacar(i, Raio)
senao:
	atacar(i, EsferaAzul)
fim se"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

