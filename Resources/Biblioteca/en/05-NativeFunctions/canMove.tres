[sub_resource type="Resource" id="Resource_ms24s"]
script = ExtResource("1_2mjnt")
texto = "Returns a boolean value indicating if the tile in the specified direction is a floor or not. Returns True if it is a floor, and False if it is an impassable barrier.

 The 'direcao' parameter must be Up(Cima), Down(Baixo), Right(Direita) ou Left(Esquerda). "
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

