[sub_resource type="Resource" id="Resource_lcow8"]
script = ExtResource("1_73fpo")
tipo = 3
texto = "#Exemplo 1

atacar(inimigoMaisProximo(), Gelo)

#Exemplo 2

Inimigo alvo = inimigoMaisProximo()
atacar(alvo, Gelo)"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

