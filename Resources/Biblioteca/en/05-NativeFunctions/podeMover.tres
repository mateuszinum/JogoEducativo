[sub_resource type="Resource" id="Resource_ms24s"]
script = ExtResource("1_gtm3b")
texto = "Retorna um valor booleano que indica se a tile na direção especificada é chão ou não.

Se for chão, retorna Verdadeiro. Se for uma barreira que não dá para passar, retorna Falso.

O parâmetro direcao deve ser Cima, Baixo, Direita ou Esquerda.
"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

