[sub_resource type="Resource" id="Resource_ms24s"]
script = ExtResource("1_4vr48")
texto = "Processes the payment to acquire the specified product, immediately adding it to the active inventory (Belt or Backpack). The purchase is only completed if you have sufficient resources and enough free space. Slots are filled from left to right in the Belt (indices 0 and 1) and from bottom to top in the Backpack. 

The \"produto\" parameter must be a string with the product name."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_ablw5"]
