[sub_resource type="Resource" id="Resource_ms24s"]
script = ExtResource("1_hd777")
texto = "Returns the integer value of the Y-axis (vertical) the player is currently standing on. 

Useful for knowing the exact vertical coordinate of the player at any given moment."
