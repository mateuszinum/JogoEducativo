[sub_resource type="Resource" id="Resource_ms24s"]
script = ExtResource("1_komd7")
texto = "Usa o item do cinto no índice especificado. Só funciona se houver um item na respectiva posição.

O parâmetro \"indice\" deve ser um número inteiro (int) que representa a posição do item no cinto."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

