[sub_resource type="Resource" id="Resource_lcow8"]
script = ExtResource("1_ckhpc")
tipo = 3
texto = "escreva(\"Eu sou um mago poderoso\")
Inimigo alvo = inimigoMaisProximo()
escreva(\"O nome do inimigo mais perto é: \" + alvo)
escreva(\"Inimigo: \" + alvo + \" Que medo!\")"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

