[sub_resource type="Resource" id="Resource_ms24s"]
script = ExtResource("1_ckhpc")
texto = "Escreve o texto informado na tela. Cada execução exibe a mensagem em uma nova linha automaticamente. A expressão \"\\n\" pode ser utilizada dentro do texto para forçar uma quebra de linha manual.

O parâmetro \"string\" deve ser o texto que se deseja exibir."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

