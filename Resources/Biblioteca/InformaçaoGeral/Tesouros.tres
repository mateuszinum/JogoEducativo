[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_lcqyc")
texto = "Toda arena de batalha esconde riquezas! Em qualquer momento da sua partida, sempre existirá exatamente um tesouro ativo no mapa. Ele usa o mesmo sistema de grade que o personagem, ou seja, o tesouro está posicionado em uma coordenada XY.

Ao chegar no tesouro, você coleta ele, e imediatamente um outro tesouro aparece em um local aleatório da arena.

Dica: Para coletar os tesouros, você precisa criar um algoritmo de navegação que move o personagem até a coordenada do tesouro através de comparações com a coordenada do personagem. Certifique-se que você consegue contornar os obstáculos no caminho!"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

