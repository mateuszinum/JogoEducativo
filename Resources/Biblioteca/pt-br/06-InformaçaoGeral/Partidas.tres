texto = "Partidas"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_l83gn")
texto = "Ao usar a função \"arena\", você entra em uma partida. Se sua vida chegar a 0, você perde todos os recursos conquistados nessa partida.

Para escapar com vida de uma partida, clique no botão \"PARAR E ESCAPAR\"[req=Automação 1]. Tambem é possível escapar de uma partida através da função \"escapar()\"[/req].
"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_pws7u"]
script = ExtResource("1_l83gn")
tipo = 2
texto = "Subindo de nível"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_f5o1o"]
script = ExtResource("1_l83gn")
texto = "A cada partida você começa no nível 1. Conforme coleta recursos, sua barra de experiência vai sendo preenchida. Quando preenchida totalmente, você sobe de nível.

O nível máximo que você pode chegar é o nível 10.

Cada nível te concede aproximadamente +10% de agilidade. Ao alcançar o nível máximo, você terá um bônus de 100%, ou seja, o dobro da agilidade."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

