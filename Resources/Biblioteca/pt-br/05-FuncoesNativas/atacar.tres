[sub_resource type="Resource" id="Resource_ms24s"]
script = ExtResource("1_3rfv1")
texto = "Realiza um ataque do tipo especificado no alvo determinado.

O parâmetro \"alvo\" deve ser uma referência para o objeto de um inimigo específico. O parâmetro \"tipoDeAtaque\" deve ser o nome do ataque."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

