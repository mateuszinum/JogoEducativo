texto = "Operadores"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_1sph2")
texto = "Os operadores são os símbolos que usamos para fazer contas matemáticas, comparar coisas ou juntar ideias.

Aritméticos (Matemática básica):
	+ : Soma
	- : Subtração
	* : Multiplicação
	/ : Divisão
	% : Resto da divisão

Comparação (Para fazer perguntas):
	== : É igual a?
	!= : É diferente de?
	>= : Maior ou igual
	<= : Menor ou igual

Lógicos (Para juntar regras):
	e : As duas condições precisam ser verdadeiras.
	ou : Apenas uma das condições precisa ser verdadeira.
	! : Inverte a regra (o que era Verdadeiro vira Falso).
"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_1sph2"]
script = ExtResource("1_1sph2")
tipo = 2
texto = "Exemplos de uso"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_4yhyu"]
script = ExtResource("1_1sph2")
tipo = 3
texto = "int vidaMaxima = 100
int dano = 15
int vidaRestante = vidaMaxima - dano
float metadeDaVida = vidaMaxima / 2

int nivel = 5
se(nivel >= 10):
	escreva(\"Você é muito forte!\")
fim se

se(alvo == Nulo):
    escreva(\"Nenhum inimigo encontrado.\")
fim se

int contador = 50
bool valor = Verdadeiro
se(contador >= 20 e valor):
    atacar(inimigoMaisProximo, EsferaAzul)
fim se

bool temBastanteVida = Falso
se(!temBastanteVida):
    escreva(\"Cuidado, você está desprotegido!\")
fim se"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

