texto = "Nulo"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_fa6qn")
texto = "O Nulo é um tipo de dado especial que representa o vazio absoluto. Quando uma variável não tem nada dentro, ou quando você tenta procurar um alvo e não encontra ninguém, o sistema retorna Nulo.

Ele é muito útil para checar se algo existe antes de tentar interagir com aquilo.
"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_fa6qn"]
script = ExtResource("1_fa6qn")
tipo = 2
texto = "Exemplo de uso"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_cu4sd"]
script = ExtResource("1_fa6qn")
tipo = 3
texto = "Inimigo alvo = inimigoMaisProximo()

se(alvo == Nulo):
    escreva(\"Ninguém por perto!\")
fim se"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

