[sub_resource type="Resource" id="Resource_sj6m0"]
script = ExtResource("1_s4kx5")
tipo = 1
texto = "Enquanto"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_s4kx5")
texto = "O \"enquanto\" serve para repetir um bloco de código várias vezes, desde que a condição que você escolheu continue sendo verdadeira. É perfeito para executar ações contínuas.

A estrutura deve ser fechada com um \"fim enquanto\"

Dica: Se você quiser que um enquanto rode infinitamente, use \"enquanto(Verdadeiro)\". Isso é um loop infinito porque a condição nunca deixará de ser verdadeira!
"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_s4kx5"]
script = ExtResource("1_s4kx5")
tipo = 2
texto = "Exemplo 1"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_agsnw"]
script = ExtResource("1_s4kx5")
tipo = 3
texto = "enquanto(Verdadeiro)
	atacar(inimigoMaisProximo(), EsferaAzul)
	mover(Esquerda)
fim enquanto"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_tcggy"]
script = ExtResource("1_s4kx5")
tipo = 2
texto = "Exemplo 2"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_6qiy6"]
script = ExtResource("1_s4kx5")
tipo = 3
texto = "enquanto(contador > 2):
	mover(Cima)
fim enquanto"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[resource]
script = ExtResource("2_6qiy6")
blocos_de_conteudo = Array[ExtResource("1_s4kx5")]([SubResource("Resource_sj6m0"), SubResource("Resource_7p0ow"), SubResource("Resource_s4kx5"), SubResource("Resource_agsnw"), SubResource("Resource_tcggy"), SubResource("Resource_6qiy6")])
