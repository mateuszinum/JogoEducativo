metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_bjala"]
script = ExtResource("1_h8jfw")
texto = "Guarda textos. Lembre-se sempre de colocar o texto entre aspas. Você também pode juntar (concatenar) textos usando o sinal de +. É possível somar textos com outros textos, ou até misturar com outros tipos de dados (como números, itens de listas e valores lógicos) que o sistema converte tudo em um texto só automaticamente!"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_h8jfw"]
script = ExtResource("1_h8jfw")
tipo = 2
texto = "Exemplo de uso"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_wwugd"]
script = ExtResource("1_h8jfw")
tipo = 3
texto = "int i = 100
bool b = Verdadeiro
string s = \"Texto\"
string s2 = \"o número é: \" + i		# s2: \"o número é: 100\"
"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

