[sub_resource type="Resource" id="Resource_7p0ow"]
script = ExtResource("1_h8jfw")
texto = "As variáveis são como caixas onde você guarda informações para usar depois. Na nossa linguagem, você precisa avisar o sistema qual é o tipo de \"caixa\" antes de dar um nome a ela.

Os tipos de dados que você pode guardar são:"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_oj1kj"]
script = ExtResource("1_h8jfw")
tipo = 2
texto = "int"
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_e7ofd"]
script = ExtResource("1_h8jfw")
texto = "Guarda números inteiros (ex: 1, 10, -5). "
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_3xve1"]
script = ExtResource("1_h8jfw")
tipo = 2
