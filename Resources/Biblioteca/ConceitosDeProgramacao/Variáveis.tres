metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_nebly"]
script = ExtResource("1_h8jfw")
texto = "Guarda números \"quebrados\" ou decimais (ex: 3.14, 0.5)."
metadata/_custom_type_script = "uid://dg4eb1rd0eaip"

[sub_resource type="Resource" id="Resource_nq2bc"]
