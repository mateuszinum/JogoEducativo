[sub_resource type="Resource" id="Resource_0dx7l"]
script = ExtResource("1_4l6a1")
tipo = 2
texto = "Inimigo i = inimigoMaisProximo()

se(i.nome == SlimeDeFogo):
	atacar(i, Gelo)
senão:
	atacar(i, EsferaAzul)
fim se"
