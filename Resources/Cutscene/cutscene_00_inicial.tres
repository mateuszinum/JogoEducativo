[sub_resource type="Resource" id="Resource_wxfft"]
script = ExtResource("1_vo31s")
imagem = ExtResource("3_6d3cj")
musica = ExtResource("1_nsjkh")
volume_musica_db = -6.0
textos = Array[String](["Há muito tempo, a magia corria livre neste mundo.", "Ela era moldada pelas mãos dos Feiticeiros Anciões, aqueles que dominavam a magia com maestria."])
metadata/_custom_type_script = "uid://cgh54v6gpqw6k"

[sub_resource type="Resource" id="Resource_6d3cj"]
script = ExtResource("1_vo31s")
imagem = ExtResource("4_nsjkh")
musica = ExtResource("1_nsjkh")
volume_musica_db = -6.0
textos = Array[String](["No entanto… De forma misteriosa, eles desapareceram, deixando para trás apenas o ápice de sua criação. Ecos da verdadeira magia: Grimórios!
"])
metadata/_custom_type_script = "uid://cgh54v6gpqw6k"

[sub_resource type="Resource" id="Resource_ddh3l"]
script = ExtResource("1_vo31s")
imagem = ExtResource("5_4sr4n")
musica = ExtResource("1_nsjkh")
volume_musica_db = -6.0
textos = Array[String](["Conhecidos nas escolas de magia, grimórios têm regras simples de utilização. 
", "Cada grimório é limitado a magias de um elemento apenas, e para usá-los, é necessário proferir os nomes dos feitiços.", "Porém, boatos corriam sobre algo maior…"])
metadata/_custom_type_script = "uid://cgh54v6gpqw6k"

[sub_resource type="Resource" id="Resource_pmxvq"]
script = ExtResource("1_vo31s")
imagem = ExtResource("6_ddh3l")
musica = ExtResource("1_nsjkh")
volume_musica_db = -6.0
textos = Array[String](["As lendas tinham ele como o “Omni-Grimório”!
", "Um livro abençoado com magias de todos elementos, mas amaldiçoado com a condição de que elas deveriam ser escritas ao invés de pronunciadas.", "Este, estava escondido nas profundezas das ruínas que ninguém ousava entrar."])
metadata/_custom_type_script = "uid://cgh54v6gpqw6k"

[sub_resource type="Resource" id="Resource_m3n3p"]
script = ExtResource("1_vo31s")
textos = Array[String](["Até que você toma coragem para encontrá-lo…"])
metadata/_custom_type_script = "uid://cgh54v6gpqw6k"

[sub_resource type="Resource" id="Resource_smi78"]
script = ExtResource("1_vo31s")
imagem = ExtResource("7_m3n3p")
musica = ExtResource("8_vxe86")
volume_musica_db = -4.0
textos = Array[String](["“Não acredito que o Omni-Grimório estava realmente lá esse tempo todo!”", "\"Agora é hora de voltar para casa.\""])
metadata/_custom_type_script = "uid://cgh54v6gpqw6k"

[sub_resource type="Resource" id="Resource_vxe86"]
script = ExtResource("1_vo31s")
musica = ExtResource("8_vxe86")
textos = Array[String](["No caminho de volta, você mantém o grimório fechado, ansioso para chegar em casa e ver o conteúdo dele.", "Chegando lá, você o posiciona em sua mesa, abre ele e uma coisa estranha acontece...", "Você não consegue mais se mover! É como se o grimório tivesse assumido o controle de todas as suas ações!", "Felizmente, você se lembra de um feitiço de movimento que o mago velho te ensinou. Use ele para sair da casa!"])
metadata/_custom_type_script = "uid://cgh54v6gpqw6k"

